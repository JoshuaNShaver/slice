# Settings for running a dedicated server against real Supabase on your
# machine (the online server gets these from GitHub secrets instead; see
# deploy/README.md). Copy to .env, fill in, then load it into your shell:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   Godot --headless --path . -- --server --port=24680 --save-dir=user://test-real/
#
# Godot doesn't read .env itself. Leave all three empty for local saves
# and device-id logins. .env is gitignored: never commit real keys.

# https://<project-ref>.supabase.co (Project Settings -> Data API)
SUPABASE_URL=

# Project Settings -> API Keys -> Secret keys (sb_secret_...).
# Server only: it can read and write every save. Never give it to players.
SUPABASE_SECRET_KEY=

# Project Settings -> API Keys -> Publishable key (sb_publishable_...).
# The server hands this to players so they can log in with Google.
SUPABASE_PUBLISHABLE_KEY=
