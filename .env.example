# Local settings. The online server and deploys get these from GitHub
# secrets instead (deploy/README.md). Copy to .env, fill in what you need,
# then load it into your shell (Godot and the Supabase CLI don't read it):
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# .env is gitignored: never commit real keys.

# --- Godot -------------------------------------------------------------------
GODOT=/Applications/Godot.app/Contents/MacOS/Godot


# --- 1. A dedicated server against real Supabase ------------------------------
#   $GODOT --headless --path . -- --server --port=24680 --save-dir=user://test-real/
# Expect "Saves: Supabase at ...; logins: supabase". Leave all three empty
# for local saves and device-id logins (a LAN/dev server).

# https://<project-ref>.supabase.co
SUPABASE_URL=
# Project Settings -> API Keys -> Secret keys (sb_secret_...).
# Server only: it can read and write every save. Never give it to players.
SUPABASE_SECRET_KEY=
# Project Settings -> API Keys -> Publishable key (sb_publishable_...).
# The server hands this to players so they can log in with Google.
SUPABASE_PUBLISHABLE_KEY=


# --- 2. Pushing tables and auth settings yourself (Supabase CLI) --------------
# What 002-deploy-code does, from your machine:
#   supabase link --project-ref "$SUPABASE_PROJECT_REF"
#   supabase db push --dry-run && supabase db push
#   supabase config diff && supabase config push
# config.toml reads the two Google values below; push fails without them.

# Supabase -> Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=
# The ID in the project's dashboard URL (supabase.com/dashboard/project/<ref>)
SUPABASE_PROJECT_REF=
# The project's database password (Project Settings -> Database)
SUPABASE_DB_PASSWORD=
# Google Cloud -> APIs & Services -> Credentials -> your OAuth client
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=


# --- 3. Tests against the mock (no real keys) ---------------------------------
# Don't mix these with section 1: set them only in the terminal running the
# tests, e.g. by prefixing the command instead of using .env:
#   python3 tools/tests/supabase_mock.py --port 54321 --secret sb_secret_test &
#   SUPABASE_URL=http://127.0.0.1:54321 SUPABASE_SECRET_KEY=sb_secret_test \
#       $GODOT --headless --path . -s tools/tests/test_supabase_store.gd
# Mock values: URL http://127.0.0.1:54321, secret sb_secret_test,
# publishable sb_publishable_test, tokens good-token-1 / good-token-2.
