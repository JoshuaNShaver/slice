# Settings for a dedicated server. Copy to .env and load it before starting
# the server (see README.md, "Saves and logins"). .env is gitignored.

# Where the server keeps saves:
#   local    - JSON files in --save-dir (default user://server/). Players log
#              in with a device id. The SUPABASE_ settings are ignored.
#   supabase - the Supabase project below. Players log in with Google.
#              All three SUPABASE_ settings are required.
#   (empty)  - supabase if SUPABASE_URL or SUPABASE_SECRET_KEY is set, else local.
SAVES=local

# https://<project-ref>.supabase.co, or http://127.0.0.1:54321 for local Supabase.
SUPABASE_URL=
# Secret key (sb_secret_...). Server only: never give it to players.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...). The server hands it to players for logging in.
SUPABASE_PUBLISHABLE_KEY=

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
